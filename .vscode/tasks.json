{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "AI Engine Server (port 8000)",
      "type": "shell",
      "command": "python3",
      "args": ["-m", "engine.server"],
      "isBackground": true,
      "problemMatcher": {
        "owner": "tinygpt-server",
        "pattern": {
          "regexp": "^(ERROR|Traceback).*"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*Starting server process|^.*Started server process",
          "endsPattern": "^.*Uvicorn running"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "runOptions": {}
    },
    {
      "label": "Start Training (30M, 4h)",
      "type": "shell",
      "command": "curl",
      "args": [
        "-s", "-X", "POST", "http://localhost:8000/api/chat/train",
        "-H", "Content-Type: application/json",
        "-d", "{\"minutes\": 240, \"d_model\": 512, \"n_layers\": 7, \"n_heads\": 8, \"block\": 128, \"vocab\": 16000, \"epochs\": 2}"
      ],
      "isBackground": false,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "Standalone Training (30M, resumable)",
      "type": "shell",
      "command": "python3",
      "args": ["scripts/train_chat.py", "--minutes", "240"],
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Check Training Progress",
      "type": "shell",
      "command": "curl",
      "args": [
        "-s", "http://localhost:8000/api/chat/status"
      ],
      "isBackground": false,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always"
      }
    }
  ]
}
